<?xml version="1.0" encoding="utf-8"?>
<!-- (F-19) نطاقات FileProvider أضيق ما تسمح الحاجة: المزود غير مُصدَّر
     (exported=false) ومنح الـURI صريح، لكن إتاحة الجذور تُضيّق أثر أي خطأ
     مستقبلي في مشاركة URI. كل مسار مشارَك فعلياً مُوثق هنا بسبيبه. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- مشاركة/فتح أي ملف اختاره المستخدم على التخزين الخارجي: جوهر مدير الملفات
         (مشاركة وفتح بواسطة وتثبيت APK من أي مجلد) — لا يمكن تضييقه أكثر. -->
    <external-path name="shared_storage" path="." />
    <!-- وضع الوصول المحدود (بلا صلاحية كل الملفات): المتصفح يجذّر في تخزين
         التطبيق ومشاركة ما فيه تعمل عبر هذا النطاق. -->
    <files-path name="app_files" path="." />
    <!-- ملفات الاستقبال المُجهَّزة من مشاركة التطبيقات الأخرى (cache/incoming_*)
         قد يعاد مشاركتها أو فتحها بالنوايا أثناء وجودها. -->
    <cache-path name="app_cache" path="." />
    <!-- حُذف external-files-path: لم يكن له مستدعٍ واحد (السجل الخارجي يُكتب
         لا يُشارك)، وإتاحة جذر كامل بلا حاجة كانت توسعاً بلا مقابل (F-19). -->
</paths>
